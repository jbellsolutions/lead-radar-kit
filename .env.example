# Lead Radar settings. The installer copies this to .env.local, which stays on your computer (never committed).
# Set keys with:  .venv/bin/python scripts/set_key.py KEY_NAME   (the value is hidden as you paste)
# Format: KEY=value, one per line. Keep comments on their own lines, never after a value.

# --- Required ---
# Search: https://app.scrapecreators.com (100 free credits, then about $10 per 5,000)
SCRAPECREATORS_API_KEY=
# AI for search plans and reading posts: https://openrouter.ai/keys (add a few dollars of credit)
OPENROUTER_API_KEY=
# Your dashboard login. Make one with: .venv/bin/python scripts/set_key.py RADAR_DASHBOARD_PASSWORD --generate
RADAR_DASHBOARD_PASSWORD=

# --- Optional ---
# Fast first-pass reader (Jev, https://typesafe.ai). Without it every post goes to the OpenRouter model.
TYPESAFE_API_KEY=
# Slack notices
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
# Your own Data Box (https://github.com/jbellsolutions/box-kit): contact cards and Indeed job listings
DATABOX_URL=
DATABOX_TOKEN=
# Your own Browser Box `read` (box-kit), program lane only: sites that block plain requests. URL without /mcp.
BROWSERBOX_URL=
BROWSERBOX_TOKEN=

# --- Spending and schedule (defaults shown; uncomment to change) ---
# ScrapeCreators credits per UTC day across all runs. A campaign run uses about 90-140.
# RADAR_DAILY_CREDIT_CAP=300
# UTC time the dashboard starts daily campaigns, or off
# RADAR_DAILY_AT=11:00
# The program lane's daily growth run (companies with affiliate programs): on or off
# RADAR_PROGRAMS_DAILY=off
